# Copy to .env and fill in. NEVER commit .env.
# Every var here is validated at boot — the API refuses to start if one is missing or malformed.

# --- runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- web (client-side; only VITE_-prefixed vars reach the browser) ---
# Leave EMPTY in development: the Vite dev server proxies /api to the API, so the browser
# talks to its own origin (no CORS, first-party session cookie). Set this to the API origin
# only when the two are deployed separately.
VITE_API_URL=

# --- api ---
API_HOST=0.0.0.0
API_PORT=5000

# Comma-separated allowlist of browser origins. Never a wildcard.
CORS_ORIGINS=http://localhost:5173

# --- infrastructure (docker compose) ---
# All optional; the defaults below are what compose falls back to.
POSTGRES_USER=leak
POSTGRES_PASSWORD=leak_dev_password
POSTGRES_DB=leakmon
POSTGRES_PORT=5433
REDIS_PORT=6379
WEB_PORT=8080
# Origin the browser uses. Drives CORS_ORIGINS and AUTH_URL for the containerised API.
APP_URL=http://localhost:8080
# The API container faces browsers directly. Set true only behind a reverse proxy.
TRUST_PROXY=false

# --- collection worker: the crawl engine ---
# Everything below is optional; the values shown are the defaults.
#
# How a crawl works: a cron looks for due work every CRAWL_SWEEP_INTERVAL_MINUTES. If any URL
# is due it starts ONE crawl cycle (only one can exist at a time, across every worker process),
# queues the due URLs in Postgres, and workers take them one at a time. Changed pages go
# through extraction; transient failures are retried later without holding a worker; the cycle
# is finalized, with a report, when nothing is left.
#
# queue = the URL-queue crawler described above. legacy = the original source-at-a-time
# crawler, kept as a switch-back. The `intel run` CLI always uses the legacy crawler.
CRAWL_ENGINE=queue
# How often the cron looks for due work (minutes, 1-60). Cheap when nothing is due: what is
# due is decided per URL, from its own interval, not by this number.
CRAWL_SWEEP_INTERVAL_MINUTES=5

# --- concurrency (SYSTEM-WIDE limits, enforced in Postgres, not per process) ---
# Running three worker processes with CRAWL_WORKERS=6 still means at most 6 fetches in flight
# in total. Deliberately NOT derived from the number of Tor SOCKS ports: they all belong to one
# Tor process and add no throughput. Tune from the logged response times, the failure rate and
# the machine's real memory (on a Raspberry Pi, start low).
# Simultaneous fetches of http-collector sources.
CRAWL_WORKERS=6
# Simultaneous fetches of browser-collector sources. Firefox is ~500MB resident: this is bound
# by RAM, not Tor. 0 disables browser sources entirely (they are skipped, not left hanging).
CRAWL_BROWSER_WORKERS=1
# Simultaneous fetches of any ONE source, so a deep listing cannot take every slot.
CRAWL_PER_SOURCE_INFLIGHT=3

# --- one fetch ---
# Seconds one attempt may take, connect to last byte. Tor needs this long; do not shorten it
# without measuring.
CRAWL_TIMEOUT=60
# Largest response body read. A bigger one is abandoned mid-stream and fails permanently
# (a leak-site page is a few hundred KB; anything near this is a file).
CRAWL_MAX_BYTES=5242880

# --- retries ---
# Attempts per URL per cycle. A transient failure (timeout, 5xx, 429, a Tor circuit that would
# not build) is retried LATER: the URL is queued again with a delay, and the worker moves on.
# Permanent ones (404, 410, 403, a CAPTCHA or access-queue page, a non-page) are not retried.
CRAWL_MAX_ATTEMPTS=3
# Delay before retry 1, doubling each time up to the cap, with +/-20% jitter (seconds).
CRAWL_RETRY_BACKOFF=15
CRAWL_RETRY_BACKOFF_CAP=120
# How long a claimed URL stays leased; a worker that dies mid-fetch is recovered when it runs
# out. 0 = twice CRAWL_TIMEOUT. The worker gives up on a fetch at 90% of this, so it must stay
# comfortably above CRAWL_TIMEOUT (the worker logs a warning if it does not).
CRAWL_LEASE_SECONDS=0
# A cycle with no sign of life for this long (seconds) is closed as "abandoned", and a job
# that runs this long is stopped by arq (the next tick resumes the cycle).
CRAWL_JOB_TIMEOUT=3600

# --- pagination ---
# Pagination is declared per source in sources.yaml (pagination_style, max_pages); every page is
# queued at once. With this on, pages 2..N of a source wait until page 1 of the same cycle has
# resolved: a dead or gated source then costs one failed fetch instead of N. Page 1 succeeding
# releases the rest at once; page 1 failing skips them. Off = every page starts immediately.
CRAWL_PAGE1_FIRST=true

# --- link following ---
# After a page's content is new or changed, follow links from it to the pages behind it (victim
# pages, proofs): same host only, never a file, never an account page. Not run through the
# listing extractor; stored and scanned for exposures.
CRAWL_FOLLOW_LINKS=true
CRAWL_LINK_DEPTH=3
# Links taken from any one page (new ones, in page order).
CRAWL_LINKS_PER_PAGE=5
# Links first found per source per cycle, in total.
CRAWL_LINK_MAX_PAGES=25
# Seconds before a followed page is fetched again (default a week). Due ones are taken back into
# a cycle on their own, without their listing having to change.
CRAWL_LINK_INTERVAL=604800
# Followed pages that have come due, re-queued per source per cycle (separate from the above,
# so a backlog of recrawls cannot crowd out new discoveries).
CRAWL_LINK_RECRAWL_MAX_PAGES=25

# --- how often each kind of page is crawled again ---
# Listing pages use the source's own intervals in services/intel/sources.yaml, per source:
#   crawl_interval_seconds        page 1 of the listing        (default 900   = 15 minutes)
#   deep_crawl_interval_seconds   pages 2..N of the listing    (default 21600 = 6 hours)
# Followed pages use CRAWL_LINK_INTERVAL above. After editing sources.yaml run
# `intel sources sync`.

# --- onion mirrors ---
# Record onion addresses a page presents as its own ("our mirror", "we have moved to") or merely
# mentions. Always safe: recording is only ever data. Both engines do this.
CRAWL_DISCOVER_MIRRORS=true
# Switch to a self-declared mirror when a source's address is dead. Off by default: these
# addresses come from pages the crawled site served, so switching lets that site choose where
# the crawler connects. LEGACY CRAWLER ONLY - the queue engine records mirrors but does not
# fail over to them (an operator can promote one with `intel mirrors use`).
CRAWL_MIRROR_FAILOVER=false

# --- legacy crawler only (CRAWL_ENGINE=legacy, and the `intel run` CLI) ---
# Attempts per fetch, retried inside the fetch with backoff (the queue engine instead retries a
# URL later, with CRAWL_MAX_ATTEMPTS).
CRAWL_RETRIES=4
# Sources crawled at once.
CRAWL_CONCURRENCY=4
# Pages of ONE source fetched at once, in doubling waves.
CRAWL_PAGE_CONCURRENCY=4
CRAWL_PAGE_WAVE_CAP=16
# Total fetches in flight across every source. 0 derives it from the settings above.
CRAWL_MAX_INFLIGHT=0
# Fair scheduling: one run aims to finish inside this window (seconds); each source gets
# window * CRAWL_CONCURRENCY / sources seconds, clamped between the min and max below.
CRAWL_RUN_WINDOW=1800
CRAWL_SOURCE_MIN_BUDGET=90
CRAWL_SOURCE_MAX_BUDGET=900

INTEL_EXTRACTOR=rules
TOR_SOCKS_PORTS=[9050,9051,9052]

# --- database ---
# Matches infra/docker-compose.yml. Change the password before this leaves your machine.
# Port 5433 on purpose — see the comment in infra/docker-compose.yml. If you have no other
# PostgreSQL on this machine you can move both back to 5432.
DATABASE_URL=postgresql://leak:leak_dev_password@localhost:5433/leakmon

# --- redis (arq queue) ---
REDIS_URL=redis://localhost:6379

# --- auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-32-bytes-of-hex
# Where the API is reachable from the browser; used for cookie domain + callback URLs.
AUTH_URL=http://localhost:5000

# --- exposure detection ---
# Credentials, keys and card numbers found in crawled pages are stored masked, never in the
# clear. This key fingerprints each finding, so a stolen database cannot be tested against a
# dictionary of common emails and passwords. Set your own before this holds anything real;
# changing it later makes old findings stop matching, and a re-crawl inserts them again.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPOSURE_SALT=replace-me-with-32-bytes-of-hex
# Set to false to turn detection off entirely.
EXPOSURE_DETECTION=true
